+// ---- LED keys that save settings ----
+// Stock RGB_TOG / RGB_VAI / RGB_VAD write the *current* colour to EEPROM, which on a
+// non-base layer is the layer colour - that would overwrite the user's base colour.
+// So: restore the saved colour first, change brightness/on-off (saved), re-apply layer colour.
+bool process_record_kb(uint16_t keycode, keyrecord_t *record) {
+    if (keycode == RGB_TOG || keycode == RGB_VAI || keycode == RGB_VAD) {
+        if (record->event.pressed) {
+            rgblight_reload_from_eeprom();
+            if (keycode == RGB_TOG) rgblight_toggle();
+            else if (keycode == RGB_VAI) rgblight_increase_val();
+            else rgblight_decrease_val();
+            layer_state_set_kb(layer_state);
+        }
+        return false;
+    }
+    return process_record_user(keycode, record);
+}
